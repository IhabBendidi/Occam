# Machine-local path registry; configs/paths.example.yaml is the tracked template
configs/paths.yaml

# Runtime outputs
runs/
wandb/
wandb_runs/
*.out
*.err
*.log

# Large binary artifacts, populated by scripts/bootstrap_assets.sh
checkpoints/**/*.pth
checkpoints/**/*.pt

# DiverseRNA shards, populated by scripts/export_dataset_hf.py
data/diverserna/data/
data/diverserna/*.parquet

# Evaluation bundle, populated by scripts/export_eval_data.py.
# manifest.json and DATASET_CARD.md stay tracked -- they are the record of what
# the bundle contains and where it came from.
data/eval/**/*.h5ad

# Panel sources are symlinks to 36 GB of h5ad; see data/panels/*/SOURCES.md
data/panels/**/src/*.h5ad
data/panels/**/*.h5ad

# Golden fixtures are large; regenerate with scripts/porting/capture_goldens.py
golden/*.npz

# Verification output and the untrusted config copied beside the release.
# Both are machine-specific run artifacts, not part of the repo.
golden/verify_report.json
checkpoints/**/*.UNTRUSTED

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# The corpus in h5ad form: a machine-local symlink, see configs/paths.yaml
data/corpus/

# Prior-knowledge graphs: 365 MB of third-party data, copied by hand from a
# shared cluster path. Not ours to redistribute; the manifest is the record.
data/graphs/**
!data/graphs/MANIFEST.json

# Benchmark definitions are all text and ARE tracked; only h5ad payloads are not.
data/benchmarks/**/*.h5ad

# The split-half panel's cell matrix, rebuilt in ~1.5 min by
# scripts/build_splithalf_panel.py. cohort.json, splits.npz, train_grand_mean.npy,
# splits_manifest.json and CARD.md stay tracked -- they are the frozen definition and the
# record of its hashes; panel.npz is 164 MB of derived float32.
data/benchmarks/rhj_fewshot/splithalf/panel.npz

# ---------------------------------------------------------------------------
# Competitor models (STATE, TxPert, CellFlow, PerturbDiff), ported from
# ~/sandbox/bc-hooke/src/hooke-tx/competitors for benchmarking on rhj_fewshot.
#
# Code, configs and the official recipes ARE tracked -- they are what lets
# someone else reproduce the comparison. Everything a run produces is not.
#
# ⚠️ They read OUR data in place (data/eval/pert/*.h5ad +
# data/benchmarks/rhj_fewshot/) via competitors/shared/occam_data.py. Nothing is
# converted, nothing is duplicated, and no competitor dataset is copied -- the
# upstream tree carries ~92 GB that is untracked AND unignored there, which must
# not follow us.
# ---------------------------------------------------------------------------
competitors/**/.venv/
competitors/**/venv/
competitors/**/outputs/
competitors/**/outputs_sweep/
competitors/**/wandb/
competitors/**/lightning_logs/
competitors/**/log/
competitors/**/logs/
competitors/**/cache/
competitors/**/checkpoints/
competitors/**/processed_data*/
competitors/**/test_norman*/
competitors/**/test_replogle*/
competitors/**/debugging/
competitors/**/cell-eval-outdir/
competitors/**/celleval/
competitors/**/artifacts/
competitors/**/results_real/
competitors/**/results_decoded/
competitors/**/results_generated/
competitors/**/indices_cache/
competitors/**/__pycache__/
competitors/**/*.egg-info/
competitors/**/.pytest_cache/
competitors/**/.ipynb_checkpoints/
competitors/**/*.ckpt
competitors/**/*.pkl
competitors/**/*.pt
competitors/**/*.h5ad
competitors/**/*.h5
competitors/**/*.npy
competitors/**/*.npz
competitors/**/*.zarr
competitors/**/*.out
competitors/**/*.err
competitors/**/*.log
competitors/**/*.sif
competitors/**/*_agg_results.csv
competitors/**/*_de.csv
# ...but the provenance records always stay tracked.
!competitors/MANIFEST.json
!competitors/**/MANIFEST.json

# Competitor predictions and scores, regenerated by
# competitors/shared/export_predictions.py + scripts/eval_competitor.py.
runs/competitors/

# reproducibility/ tracks the MANIFEST + config for each frozen checkpoint; the weights
# themselves are ~100 MB each and go to HuggingFace, not git.
reproducibility/**/*.ckpt
reproducibility/**/*.pth

# cell-eval scratch. STATE's validation callback used to default MetricsEvaluator's outdir to
# the RELATIVE "./cell-eval-outdir", which lands in the checked-out repo (133 MB of pdex DE
# csv) and collides between concurrent seeds. Fixed to write per-run; ignored belt-and-braces.
competitors/**/cell-eval-outdir/
**/celleval_scratch/

# cell-eval scratch at the REPO ROOT too. `MetricsEvaluator`'s outdir default is the RELATIVE
# "./cell-eval-outdir", so a run whose cwd is the repo root drops ~205 MB of pdex DE csv here.
# Two such files (103 MB each) reached a commit and would have been REJECTED by GitHub, whose
# hard limit is 100 MB per file. The callback now writes per-run; this is the backstop.
/cell-eval-outdir/

# reproducibility/: git tracks the MANIFEST, the config and the cell-eval CSVs -- everything
# needed to READ a result. The weights and prediction h5ads are multi-GB and go to
# HuggingFace, verified afterwards against the manifest's sha256.
reproducibility/**/*.h5ad
reproducibility/**/*.torch
reproducibility/**/*.npy

# ---- norman_combo (Norman 2019 / GSE133344) ----------------------------------------------
# The GEO downloads and the derived per-gene statistics: 3.2 GB of primary data plus a 1.2 GB
# dispersion table. Both are REBUILDABLE from the accession by
# scripts/norman/norman_gene_stats.py and scripts/pert_group_dispersion.py, and neither
# belongs in a git history.
data/external/
cache/
# The panel MATRIX is 150 MB -- above GitHub's 100 MB hard limit -- and is a pure function of
# the source h5ad + axis.npz + the builder. Git keeps the benchmark DEFINITION (axis, cohort,
# splits, baselines, manifest, CARD); the matrix lives on HuggingFace beside the .h5ad.
data/benchmarks/**/panel.npz

# ---- artifacts that must never re-enter the history -------------------------------------
# An 18 GB CellFlow.pkl and 1.2 GB of pert_means tables reached commits 811de7e / 1cd169b and
# made the branch UNPUSHABLE: GitHub caps a pack at 2 GiB and a file at 100 MB. They were
# purged from history on 2026-09-21; these rules stop it happening again. All of them are
# rebuildable (scripts/pert_group_means.py) or live on HuggingFace.
reproducibility/**/*.pkl
reproducibility/**/*.pt
cache/pert_means/
cache/pert_disp/
